# Server Settings
PORT=5000
NODE_ENV=development

# Database Settings (PostgreSQL)
DATABASE_URL="file:./dev.db"

# Security & Authentication Settings
JWT_ACCESS_SECRET="super-secret-access-key-should-be-long-and-random-12345"
JWT_REFRESH_SECRET="super-secret-refresh-key-should-be-long-and-random-12345"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX=100

# File Upload Configuration
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=5

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  name          String
  profileImage  String?
  role          String         @default("USER")
  savedPortfolios String?
  activeDraft     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  portfolios    Portfolio[]
  refreshTokens RefreshToken[]
  activityLogs  ActivityLog[]

  @@index([email])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Portfolio {
  id           String         @id @default(uuid())
  userId       String
  title        String
  slug         String         @unique
  published    Boolean        @default(false)
  views        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme        Theme?
  profile      ProfileSection?
  about        AboutSection?
  contact      ContactSection?
  skills       Skill[]
  projects     Project[]
  experiences  Experience[]
  educations   Education[]
  certificates Certificate[]
  achievements Achievement[]
  socialLinks  SocialLink[]

  @@index([userId])
  @@index([slug])
}

model Theme {
  id           String    @id @default(uuid())
  portfolioId  String    @unique
  primaryColor String    @default("#3B82F6")
  accentColor  String    @default("#10B981")
  font         String    @default("Inter")
  layout       String    @default("classic")
  darkMode     Boolean   @default(false)
  animations   Boolean   @default(true)
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model ProfileSection {
  id          String    @id @default(uuid())
  portfolioId String    @unique
  fullName    String
  title       String
  bio         String?
  avatarUrl   String?
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model AboutSection {
  id          String    @id @default(uuid())
  portfolioId String    @unique
  text        String
  subHeading  String?
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model ContactSection {
  id          String    @id @default(uuid())
  portfolioId String    @unique
  email       String
  phone       String?
  website     String?
  location    String?
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model SocialLink {
  id          String    @id @default(uuid())
  portfolioId String
  platform    String    // e.g. "github", "linkedin", "twitter"
  url         String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

model Skill {
  id              String    @id @default(uuid())
  portfolioId     String
  name            String
  category        String?   // e.g. "Frontend", "Backend"
  experienceLevel String?   // e.g. "Beginner", "Intermediate", "Expert"
  years           Float?
  orderIndex      Int       @default(0)
  portfolio       Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

model Project {
  id          String    @id @default(uuid())
  portfolioId String
  title       String
  description String
  imageUrl    String?
  liveUrl     String?
  githubUrl   String?
  orderIndex  Int       @default(0)
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

model Experience {
  id               String    @id @default(uuid())
  portfolioId      String
  company          String
  position         String
  description      String?
  startDate        DateTime
  endDate          DateTime?
  currentlyWorking Boolean   @default(false)
  orderIndex       Int       @default(0)
  portfolio        Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

model Education {
  id          String    @id @default(uuid())
  portfolioId String
  college     String
  degree      String
  cgpa        Float?
  startDate   DateTime
  endDate     DateTime?
  orderIndex  Int       @default(0)
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

model Certificate {
  id            String    @id @default(uuid())
  portfolioId   String
  name          String
  issuer        String
  date          DateTime?
  credentialUrl String?
  imageUrl      String?
  orderIndex    Int       @default(0)
  portfolio     Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

model Achievement {
  id          String    @id @default(uuid())
  portfolioId String
  title       String
  description String?
  date        DateTime?
  orderIndex  Int       @default(0)
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String
  action      String   // e.g., "USER_REGISTER", "PORTFOLIO_PUBLISHED"
  description String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
